#!/usr/bin/env bash
set -euo pipefail

APP_DATA_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DATA_DIR}/data"
PROXY_PORT="${APP_PROXY_PORT:-7456}"
LOCAL_DOMAIN="${DEVICE_DOMAIN_NAME:-umbrel.local}"

mkdir -p "${DATA_DIR}"
chmod -R a+rwX "${DATA_DIR}"

# Discover the Tailscale MagicDNS name (if Tailscale is installed) and add
# it to the allowed origins, alongside the local .local domain.
PUBLIC_DOMAIN=""
TAILSCALE_STATUS=$(docker exec tailscale_web_1 tailscale status --json 2>/dev/null || true)
if [ -n "$TAILSCALE_STATUS" ]; then
  PUBLIC_DOMAIN=$(printf '%s' "$TAILSCALE_STATUS" | python3 -c 'import sys, json; d=json.load(sys.stdin); print(d.get("Self", {}).get("DNSName", "").rstrip("."))')
fi

ORIGINS="http://${LOCAL_DOMAIN}:${PROXY_PORT},https://${LOCAL_DOMAIN}:${PROXY_PORT}"
if [ -n "$PUBLIC_DOMAIN" ]; then
  ORIGINS="${ORIGINS},http://${PUBLIC_DOMAIN}:${PROXY_PORT},https://${PUBLIC_DOMAIN}:${PROXY_PORT}"
fi

printf 'APP_YAKITORI_OPEN_DESIGN_ALLOWED_ORIGINS=%s\n' "$ORIGINS" > "${APP_DATA_DIR}/.env"
