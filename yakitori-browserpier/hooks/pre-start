#!/bin/sh
# Before every start of the app, after a reboot too: loads BrowserPier's
# AppArmor profile into the kernel with the host's apparmor_parser. On
# umbrelOS 2.0 (Debian 13, AppArmor 4) Docker's own profile refuses
# Chromium's sandbox with Docker 29.1 and earlier, so browsers run under
# this one instead: docker-default plus user namespaces. It isn't installed
# in /etc/apparmor.d: loaded here at each start, it can't outlive the app.
#
# The profile and its loader are written out below, not shipped next to
# this hook: Umbrel's app update copies only the files it knows
# (docker-compose.yml, umbrel-app.yml, exports.sh, hooks/, icon.svg).
# They are copies of images/chromium/apparmor/browserpier and load. Edit
# those, then run `go generate -run gen_umbrel_hook ./images/chromium`;
# a test fails when the copies here drift.
#
# Umbrel ignores a hook's exit status, so this always exits 0 and says
# what it did in one line, on stderr, for umbreld's journal (0.2.0 showed
# umbreld logs a hook's stderr). If loading fails,
# BrowserPier finds the profile missing and runs browsers under Docker's
# profile if the sandbox works there, otherwise without AppArmor, and its
# log says which and why.

say() { echo "BrowserPier AppArmor: $*"; }

dir="$(mktemp -d 2>/dev/null)" || dir=""
if [ -z "${dir}" ] || [ ! -d "${dir}" ]; then
  say "couldn't load the browserpier profile: no temporary directory (mktemp -d failed)" >&2
  exit 0
fi
trap 'rm -rf "${dir}"' EXIT
trap 'exit 0' HUP INT TERM

written=yes
cat >"${dir}/browserpier" <<'BROWSERPIER_PROFILE' || written=no
abi <abi/4.0>,
# BrowserPier's AppArmor profile for its browser containers.
#
# Docker's docker-default, as generated by github.com/moby/profiles/apparmor
# (v0.2.0's template, Apache-2.0, Copyright The Moby Authors), plus the
# user namespace Chromium's sandbox needs. Docker's own profile has no
# userns rule. As Docker 29.1 and earlier generate it (no ABI line), under
# AppArmor 4 (Debian 13, umbrelOS 2.0) it refuses the sandbox its namespace
# and Chromium aborts; Docker 29.9 pins it to ABI 3.0, which doesn't
# mediate user namespaces, so it works there. See SPEC.md, "AppArmor".
#
# The ABI is pinned to 4.0: the first that mediates user namespaces, and
# the last where "network," still covers unix sockets. Load it with
#   apparmor_parser -r /etc/apparmor.d/browserpier
# and start containers with --security-opt apparmor=browserpier.
# Changes from moby's template are marked "BrowserPier:".

#include <tunables/global>

profile browserpier flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # BrowserPier: Chromium's sandbox puts each renderer in its own user
  # namespace (with its own PID and network namespaces). The container
  # still drops every capability but SYS_CHROOT, and runs with
  # no-new-privileges and BrowserPier's seccomp profile.
  userns,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  # BrowserPier: moby fills in dockerd's own profile here; it runs
  # unconfined on the hosts this profile is for, which the rule above covers.
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=browserpier,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,
  # BrowserPier: nor swap its root; Chromium's sandbox chroots instead.
  # (Under ABI 4.0, POSIX message queues are mediated, and refused, since
  # nothing here grants them. io_uring isn't mediated before ABI 5.0;
  # BrowserPier's seccomp profile blocks it.)
  deny pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer=browserpier,
}
BROWSERPIER_PROFILE
cat >"${dir}/load" <<'BROWSERPIER_LOADER' || written=no
#!/bin/sh
# Loads BrowserPier's AppArmor profile (./browserpier) into the kernel, on
# the hosts that may need it: AppArmor 4 without Ubuntu's user namespace
# restriction (Debian 13, umbrelOS 2.0), where Docker's own profile refuses
# Chromium's sandbox with Docker 29.1 and earlier (newer ones pin their
# profile to ABI 3.0, which doesn't mediate user namespaces). Anywhere else
# it says why and does nothing.
#
#   load [--persist DIR]
#
# --persist DIR also installs the profile as DIR/browserpier, the host's
# /etc/apparmor.d as this process sees it, so the host loads it at boot.
#
# Run as root with CAP_MAC_ADMIN and the host's /sys/kernel/security: on
# the host (Umbrel's hooks/pre-start), or in the browser image's loader
# service (deploy/docker-compose.yml, --profile apparmor). It says what it
# did in one line ("loaded the browserpier profile", "browserpier profile
# not needed here: …" or "couldn't load the browserpier profile: …"), plus
# one about installing it with --persist. It exits non-zero when it can't
# load the profile, but nothing waits on that: BrowserPier then runs
# browsers under Docker's profile if Chromium's sandbox works there,
# otherwise without AppArmor, and its log says which.
#
# BROWSERPIER_APPARMOR_FS and BROWSERPIER_APPARMOR_RESTRICT stand in for
# the kernel's paths in tests.
set -eu

here="$(dirname "$0")"
profile="${here}/browserpier"
persist=""
while [ $# -gt 0 ]; do
  case "$1" in
    --persist) persist="${2:?--persist needs a directory}"; shift 2 ;;
    *) echo "usage: $0 [--persist DIR]" >&2; exit 2 ;;
  esac
done

say() { echo "BrowserPier AppArmor: $*"; }
skip() {
  say "browserpier profile not needed here: $*"
  exit 0
}
fail() {
  say "couldn't load the browserpier profile: $*. BrowserPier falls back to Docker's profile, or to none, and its log says which; see \"AppArmor\" in BrowserPier's deploy/README.md to load the profile by hand." >&2
  exit 1
}

aa="${BROWSERPIER_APPARMOR_FS:-/sys/kernel/security/apparmor}"
restrict="${BROWSERPIER_APPARMOR_RESTRICT:-/proc/sys/kernel/apparmor_restrict_unprivileged_userns}"
if [ ! -d "${aa}" ]; then
  skip "AppArmor isn't on (no ${aa})"
fi
# Ubuntu's kernels list it as a file, Debian's (6.12) as a word in mask.
if [ ! -e "${aa}/features/namespaces/userns_create" ] &&
  ! grep -qw userns_create "${aa}/features/namespaces/mask" 2>/dev/null; then
  skip "this kernel doesn't mediate user namespaces, so Docker's profile works"
fi
if [ -e "${restrict}" ]; then
  skip "Ubuntu's user namespace restriction is here, and Docker's profile works under it"
fi
# Docker's profile is compiled by the host's parser. Before AppArmor 4 it
# doesn't know user namespaces, so it doesn't mediate them and Docker's
# profile works. The host's parser must also read ours at boot.
abi="${persist:-/etc/apparmor.d}/abi/4.0"
if [ ! -e "${abi}" ]; then
  skip "the host's AppArmor is older than 4.0 (no ${abi}), so Docker's profile works"
fi

# Loading policy takes root in the host's own user namespace: not a
# rootless Docker or Podman, nor a daemon with userns-remap.
if [ "$(id -u)" != 0 ] || [ "$(awk 'NR == 1 { print $1, $2, $3 } END { print NR }' /proc/self/uid_map | tr '\n' ' ')" != "0 0 4294967295 1 " ]; then
  fail "this isn't root on the host (a rootless or userns-remapped container runtime, say)"
fi

if [ -n "${persist}" ] && ! cmp -s "${profile}" "${persist}/browserpier"; then
  # Not fatal: loaded below, it holds until the host restarts.
  if cp "${profile}" "${persist}/.browserpier.tmp" &&
    chmod 644 "${persist}/.browserpier.tmp" &&
    mv -f "${persist}/.browserpier.tmp" "${persist}/browserpier"; then
    say "installed ${persist}/browserpier, for the host to load at boot"
  else
    rm -f "${persist}/.browserpier.tmp"
    say "couldn't install ${persist}/browserpier, so after the host restarts, browsers run without AppArmor until this runs again" >&2
  fi
fi

# Hooks may run with a PATH that leaves out the sbin directories.
parser="$(command -v apparmor_parser 2>/dev/null || true)"
for p in /usr/sbin/apparmor_parser /sbin/apparmor_parser; do
  if [ -z "${parser}" ] && [ -x "${p}" ]; then
    parser="${p}"
  fi
done
if [ -z "${parser}" ]; then
  fail "no apparmor_parser here"
fi
# Its complaints joined into the one line, so a log shows why; and its
# warnings when it loads all the same.
if ! out="$("${parser}" --replace --skip-cache "${profile}" 2>&1)"; then
  fail "${parser} failed: $(printf '%s' "${out:-no output}" | tr '\n' ' ')"
fi
if [ -n "${out}" ]; then
  say "loaded the browserpier profile (${parser} said: $(printf '%s' "${out}" | tr '\n' ' '))"
else
  say "loaded the browserpier profile"
fi
BROWSERPIER_LOADER
if [ "${written}" != yes ]; then
  say "couldn't load the browserpier profile: couldn't write it to ${dir}" >&2
  exit 0
fi

# The loader prints one line; joined anyway, in case something else spoke.
out="$(sh "${dir}/load" 2>&1)"
status=$?
out="$(printf '%s' "${out}" | tr '\n' ' ')"
if [ "${status}" = 0 ]; then
  echo "${out:-BrowserPier AppArmor: the loader said nothing}" >&2
else
  echo "${out:-BrowserPier AppArmor: couldn't load the browserpier profile: the loader exited ${status}}" >&2
fi
exit 0
