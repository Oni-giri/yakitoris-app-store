#!/usr/bin/env bash
set -euo pipefail

# Resolve APP_DATA_DIR from this script's location (hooks/ sits in $APP_DATA_DIR).
APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"

# The container runs as uid 1000 and writes everything under data/. Docker would
# otherwise create the bind-mount source as root:root. Idempotent.
mkdir -p "${APP_DATA_DIR}/data"
chown 1000:1000 "${APP_DATA_DIR}/data"
