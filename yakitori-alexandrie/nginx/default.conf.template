# Alexandrie single-origin front for Umbrel.
#
# Upstream expects three browser-facing URLs (frontend, API, S3 CDN). Umbrel
# gives an app one port, so they are merged here:
#   /api/*         -> Go backend (routes already live under /api)
#   /alexandrie/*  -> RustFS bucket "alexandrie" (path-style, read-only)
#   everything     -> Nuxt frontend
#
# ${PUBLIC_HOST} is filled in by the nginx image's envsubst step at startup.
# nginx's own $variables are left alone because they are not set in the
# environment.
#
# Upstreams are addressed by unique container names (all Umbrel apps share one
# Docker network) and resolved per request so nginx starts even if they're not
# up yet and follows them across restarts.

# Umbrel's app_proxy sits in front of us and may rewrite Host. The backend's
# CORS layer only treats a request as same-origin when Origin == http(s)://Host,
# so hand it the Origin's host back, but only when that host matches the Host
# or X-Forwarded-Host the browser actually reached us on. Cross-site origins
# fall through to the default and are rejected by the backend as before.
map "$http_origin $http_host $http_x_forwarded_host" $api_host {
    "~^https?://(?<oh>[^\s/]+) \k<oh> "        $oh;
    "~^https?://(?<oh>[^\s/]+) \S+ \k<oh>$"    $oh;
    default                                     $http_host;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    # Backup imports can be large; single uploads are capped at 20 MB by the
    # backend itself.
    client_max_body_size 1G;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $alexandrie_web     yakitori-alexandrie_frontend_1:8200;
    set $alexandrie_api     yakitori-alexandrie_backend_1:8201;
    set $alexandrie_storage yakitori-alexandrie_rustfs_1:9000;

    location /api/ {
        proxy_set_header Host $api_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://$alexandrie_api;
    }

    location /alexandrie/ {
        # Files are served from a public-read bucket; never let the browser
        # write to S3 directly.
        limit_except GET {
            deny all;
        }
        # Presigned backup URLs are signed for MINIO_PUBLIC_URL's host.
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://$alexandrie_storage;
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_pass http://$alexandrie_web;
    }
}
