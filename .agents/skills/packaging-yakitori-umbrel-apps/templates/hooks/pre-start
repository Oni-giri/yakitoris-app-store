#!/usr/bin/env bash
# Only needed for UPDATES that add a bind-mount directory: data/ scaffolding is
# not copied into existing installs, and umbreld would create the directory as
# root. Runs as root on the host before every start; failures are ignored by
# umbrelOS and it may run several times, so keep it idempotent and quiet.
# Delete this file for new packages that do not need it.
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DATA_ROOT:-${APP_DIR}/data}"

# Added in 1.5.0: uploads are written by the web container as uid 1000.
if [[ ! -d "${DATA_DIR}/uploads" ]]; then
  mkdir -p "${DATA_DIR}/uploads"
fi
if [[ "$(stat -c %u "${DATA_DIR}/uploads")" != 1000 ]]; then
  chown 1000:1000 "${DATA_DIR}/uploads"
fi
