# Nogon front for Umbrel.
#
# Nogon checks the Origin header of web-UI search and MCP requests against
# server.base_url (hostname, port and scheme). Umbrel users reach the app on
# several hostnames (umbrel.local, LAN IP, Tailscale IP / MagicDNS, HTTPS via
# Tailscale Serve), so a same-origin request from any of them gets its Origin
# replaced with ${PUBLIC_ORIGIN} (= base_url).
#
# "Same-origin" means the Origin's host:port equals the Host, or the
# X-Forwarded-Host, the browser actually reached us on (Umbrel's app_proxy
# may rewrite one of them). Anything else, i.e. a cross-site page, keeps its
# real Origin and is rejected by Nogon exactly as before. Requests without an
# Origin (CLI, MCP clients) stay without one.
#
# ${PUBLIC_ORIGIN} is filled in by the nginx image's envsubst step at startup.
# nginx's own $variables are left alone because they are not set in the
# environment.

map "$http_origin $http_host $http_x_forwarded_host" $nogon_origin {
    "~^https?://(?<oh>[^\s/]+) \k<oh> "        "${PUBLIC_ORIGIN}";
    "~^https?://(?<oh>[^\s/]+) \S+ \k<oh>$"    "${PUBLIC_ORIGIN}";
    default                                     $http_origin;
}

# The address the browser used, for rewriting /api/config below. Prefer Host;
# fall back to the first X-Forwarded-Host entry if app_proxy replaced Host with
# a container name (those contain "_", which no real hostname does), and to
# ${PUBLIC_HOST} if neither looks like a host[:port].
map "$http_host|$http_x_forwarded_host" $client_host {
    "~^(?<h>[A-Za-z0-9.-]+(:[0-9]+)?|\[[0-9A-Fa-f:.]+\](:[0-9]+)?)\|"   $h;
    "~\|(?<h>[A-Za-z0-9.-]+(:[0-9]+)?|\[[0-9A-Fa-f:.]+\](:[0-9]+)?)(,|$)" $h;
    default                                                            "${PUBLIC_HOST}";
}

# https only when a proxy in front (e.g. Tailscale Serve) says so.
map $http_x_forwarded_proto $client_ws_scheme {
    "~^https"   wss;
    default     ws;
}
map $http_x_forwarded_proto $client_http_scheme {
    "~^https"   https;
    default     http;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    # Some pages and PDFs sent by the extension exceed nginx's 1 MB default.
    client_max_body_size 100m;

    # Resolve per request so nginx starts before Nogon is up and follows it
    # across restarts (all Umbrel apps share one Docker network, hence the
    # unique container name).
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $nogon yakitori-nogon_server_1:4433;

    # The web UI takes its API and websocket addresses from /api/config
    # (baseUrl, wsUrl, searchUrl), which Nogon fills from server.base_url,
    # i.e. umbrel.local. Point them at the address this browser actually
    # used, so search works over Tailscale or by IP where umbrel.local does
    # not resolve.
    location = /api/config {
        proxy_set_header Host $http_host;
        proxy_set_header Origin $nogon_origin;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Accept-Encoding "";

        sub_filter_types application/json;
        sub_filter_once off;
        sub_filter "http://${PUBLIC_HOST}" "$client_http_scheme://$client_host";
        sub_filter "ws://${PUBLIC_HOST}"   "$client_ws_scheme://$client_host";

        proxy_pass http://$nogon;
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header Origin $nogon_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /search is a websocket.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
        proxy_pass http://$nogon;
    }
}
