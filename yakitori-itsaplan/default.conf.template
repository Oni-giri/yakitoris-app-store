# It's a Plan single-origin front for Umbrel.
#
# External API_URL is <origin>/api. The API itself has no /api deployment
# prefix, so /api/* is stripped before proxying. OAuth discovery documents are
# the exception: they are sent to the API unchanged.
#
# The web app and API share one canonical absolute HTTPS origin. This is
# required by the app's authentication configuration, passkeys, generated MCP
# client URLs, and OAuth metadata; alternate hostnames need upstream support.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_x_forwarded_proto $itsaplan_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80 default_server;
    server_name _;

    # The application enforces its own per-file limits in the interface.
    client_max_body_size 1G;
    absolute_redirect off;
    port_in_redirect off;

    # Resolve Docker names per request, including after a container recreation.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $itsaplan_api yakitori-itsaplan_api_1:3000;
    set $itsaplan_web yakitori-itsaplan_web_1:3001;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $itsaplan_proto;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # MCP, agent chats, and agent runs are streaming endpoints.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://$itsaplan_api;
    }

    location ~ ^/\.well-known/(oauth-authorization-server|oauth-protected-resource|openid-configuration)(/|$) {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $itsaplan_proto;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_pass http://$itsaplan_api;
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $itsaplan_proto;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://$itsaplan_web;
    }
}
